{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-velvet-margin",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-10",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": true,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "56889",
      "simple": { "limit": 5, "period": 60 }
    }
  ],
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "thevelvetmargin@hotmail.com",
      "allowed_sender_addresses": [
        "contato@thevelvetmargin.com.br"
      ]
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "routes": [
    {
      "pattern": "thevelvetmargin.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.thevelvetmargin.com.br",
      "custom_domain": true
    }
  ]
}
