{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "the-velvet-margin",
  "main": "./src/index.ts",
  "compatibility_date": "2026-08-03",
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "send_email": [
    {
      "name": "CONTACT_EMAIL",
      "destination_address": "thevelvetmargin@hotmail.com",
      "allowed_sender_addresses": [
        "contato@thevelvetmargin.com.br"
      ]
    }
  ],
  "routes": [
    {
      "pattern": "thevelvetmargin.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.thevelvetmargin.com.br",
      "custom_domain": true
    }
  ]
}
